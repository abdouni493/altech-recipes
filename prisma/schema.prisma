// Recettes altech — data model (Supabase Postgres).
// The database is created by supabase/schema.sql (tables, RLS, auth functions, storage buckets).
// This file only mirrors it for the Prisma client: never run `prisma db push` / migrations against it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per Supabase Auth user (id = auth.users.id). role: ADMIN | WORKER | CLIENT
model User {
  id          String   @id @db.Uuid
  username    String   @unique
  role        String   @default("CLIENT")
  name        String   @default("")
  email       String?
  language    String   @default("fr")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client      Client?

  @@map("profiles")
}

/// dimension: VOLUME | MASS | COUNT | OTHER ; factor converts to the base unit of the dimension (L, kg, pc)
model Unit {
  id          String               @id @default(uuid())
  name        String
  nameAr      String               @default("") @map("name_ar")
  symbol      String
  dimension   String               @default("OTHER")
  factor      Decimal              @default(1) @db.Decimal(20, 8)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  products    Product[]
  ingredients RecipeIngredient[]
  recipes     Recipe[]
  history     CalculationHistory[]

  @@map("units")
}

model Product {
  id            String             @id @default(uuid())
  name          String
  nameAr        String             @default("") @map("name_ar")
  description   String             @default("")
  descriptionAr String             @default("") @map("description_ar")
  imageUrl      String?            @map("image_url")
  unitId        String             @map("unit_id")
  unit          Unit               @relation(fields: [unitId], references: [id])
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredients   RecipeIngredient[]

  @@map("products")
}

model Recipe {
  id                 String               @id @default(uuid())
  name               String
  nameAr             String               @default("") @map("name_ar")
  description        String               @default("")
  descriptionAr      String               @default("") @map("description_ar")
  imageUrl           String?              @map("image_url")
  outputQuantity     Decimal              @map("output_quantity") @db.Decimal(20, 6)
  outputUnitId       String               @map("output_unit_id")
  outputUnit         Unit                 @relation(fields: [outputUnitId], references: [id])
  isVisibleOnWebsite Boolean              @default(true) @map("is_visible_on_website")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredients        RecipeIngredient[]
  packs              PackRecipe[]
  permissions        ClientPermission[]
  history            CalculationHistory[]
  favorites          Favorite[]
  orders             Order[]

  @@map("recipes")
}

model RecipeIngredient {
  id        String  @id @default(uuid())
  recipeId  String  @map("recipe_id")
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(20, 6)
  unitId    String  @map("unit_id")
  unit      Unit    @relation(fields: [unitId], references: [id])
  position  Int     @default(0)

  @@unique([recipeId, productId])
  @@map("recipe_ingredients")
}

model Pack {
  id            String             @id @default(uuid())
  name          String
  nameAr        String             @default("") @map("name_ar")
  description   String             @default("")
  descriptionAr String             @default("") @map("description_ar")
  imageUrl      String?            @map("image_url")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipes       PackRecipe[]
  permissions   ClientPermission[]
  orders        Order[]

  @@map("packs")
}

model PackRecipe {
  packId   String @map("pack_id")
  pack     Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  recipeId String @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([packId, recipeId])
  @@map("pack_recipes")
}

model Client {
  id           String               @id @default(uuid())
  serialNumber Int                  @unique @map("serial_number")
  fullName     String               @map("full_name")
  phone        String
  address      String               @default("")
  userId       String               @unique @map("user_id") @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions  ClientPermission[]
  history      CalculationHistory[]
  favorites    Favorite[]

  @@map("clients")
}

/// Source of truth for what a client can see. packId only remembers where the recipe came from.
model ClientPermission {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipeId  String   @map("recipe_id")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  packId    String?  @map("pack_id")
  pack      Pack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([clientId, recipeId])
  @@map("client_permissions")
}

model Order {
  id                 String    @id @default(uuid())
  orderNumber        String    @unique @map("order_number")
  fullName           String    @map("full_name")
  phone              String
  wilayaCode         String    @map("wilaya_code")
  wilayaName         String    @map("wilaya_name")
  communeName        String    @map("commune_name")
  recipeId           String?   @map("recipe_id")
  recipe             Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  packId             String?   @map("pack_id")
  pack               Pack?     @relation(fields: [packId], references: [id], onDelete: SetNull)
  message            String    @default("")
  wantsClientAccount Boolean   @default(false) @map("wants_client_account")
  status             String    @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@map("orders")
}

/// Single row (id = 1). Translatable fields have Fr / Ar variants.
model SiteSettings {
  id                Int      @id @default(1)
  siteNameFr        String   @default("Recettes altech") @map("site_name_fr")
  siteNameAr        String   @default("وصفات ألتك") @map("site_name_ar")
  siteDescriptionFr String   @default("") @map("site_description_fr")
  siteDescriptionAr String   @default("") @map("site_description_ar")
  logoUrl           String?  @map("logo_url")
  faviconUrl        String?  @map("favicon_url")
  heroImages        String   @default("[]") @map("hero_images") // JSON array of image URLs
  heroTitleFr       String   @default("") @map("hero_title_fr")
  heroTitleAr       String   @default("") @map("hero_title_ar")
  heroSubtitleFr    String   @default("") @map("hero_subtitle_fr")
  heroSubtitleAr    String   @default("") @map("hero_subtitle_ar")
  aboutTextFr       String   @default("") @map("about_text_fr")
  aboutTextAr       String   @default("") @map("about_text_ar")
  howItWorksFr      String   @default("") @map("how_it_works_fr")
  howItWorksAr      String   @default("") @map("how_it_works_ar")
  ctaTextFr         String   @default("") @map("cta_text_fr")
  ctaTextAr         String   @default("") @map("cta_text_ar")
  footerTextFr      String   @default("") @map("footer_text_fr")
  footerTextAr      String   @default("") @map("footer_text_ar")
  metaTitleFr       String   @default("") @map("meta_title_fr")
  metaTitleAr       String   @default("") @map("meta_title_ar")
  metaDescriptionFr String   @default("") @map("meta_description_fr")
  metaDescriptionAr String   @default("") @map("meta_description_ar")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model ContactSettings {
  id              Int      @id @default(1)
  facebookUrl     String   @default("") @map("facebook_url")
  instagramUrl    String   @default("") @map("instagram_url")
  tiktokUrl       String   @default("") @map("tiktok_url")
  phone           String   @default("")
  whatsappNumber  String   @default("") @map("whatsapp_number")
  mapsLocationUrl String   @default("") @map("maps_location_url")
  email           String   @default("")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contact_settings")
}

model CalculationHistory {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipeId       String   @map("recipe_id")
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  targetQuantity Decimal  @map("target_quantity") @db.Decimal(20, 6)
  unitId         String   @map("unit_id")
  unit           Unit     @relation(fields: [unitId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("calculation_history")
}

model Favorite {
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recipeId  String   @map("recipe_id")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([clientId, recipeId])
  @@map("favorites")
}

/// Monotonic counters (client serial numbers, order numbers) — values are never reused.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

/// Key/value app metadata (e.g. lastBackupAt).
model AppMeta {
  key   String @id
  value String

  @@map("app_meta")
}
