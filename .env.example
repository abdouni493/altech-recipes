# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://yzjihcjnwtyigkpzrlro.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Postgres (Project Settings → Database → Connect). Replace [YOUR-PASSWORD] and the region host.
# Transaction pooler (port 6543), used by the app:
DATABASE_URL="postgresql://postgres.yzjihcjnwtyigkpzrlro:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Domain used to build the login e-mail of clients and workers that only have a username.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN="altech-recipes.app"
